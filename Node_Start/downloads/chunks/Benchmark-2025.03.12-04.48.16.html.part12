" id="bg" alt="">	  <div id="base"  style="width: 100%;">    <div id="mainContainerPaddingLeft" style="display: inline-block; width:1%; height:auto;">    </div>        <div id="mainContainer">      <!-- HEADER -->      <div id="header">        <img id="header_img" src="data:image/png;base64,"/>        <div id="header_benchmark">          <p><span id="local_text_your_advanced" class="header_benchmark_line1">YOUR ADVANCED</span></p>          <p><span id="local_text_benchmark_result" class="header_benchmark_line2">BENCHMARK RESULTS</span></p>        </div>      </div>      <div id="upper">        <div id="innerUpperLeft">          <!-- CHARTS CONTAINER -->          <div id="chart_horizontal_caption">            <p><span id="local_text_frame_output_performance">FRAMES PERFORMANCE</span></p>          </div>          <div id="main_fps_div" class="chart_container">            <canvas id="canvas_main_fps" style="width:100%; height: 200px;"></canvas>          </div>          <div id="chart_horizontal_caption">            <p><span id="local_text_gpu_render_performance">GPU RENDER PERFORMANCE</span></p>          </div>          <div class="chart_container">            <canvas id="canvas_main_gpu_time" style="width:100%; height: 200px;"></canvas>          </div>          <div id="chart_horizontal_caption">            <p><span id="local_text_cpu_render_performance">CPU RENDER PERFORMANCE</span></p>          </div>          <div class="chart_container">            <canvas id="canvas_main_cpu_time" style="width:100%; height: 200px;"></canvas>          </div>          <!-- Previous Benchmark Results -->          <div id="checkbox_custom_outer_container">            <label class="checkbox_custom_container"><span id="local_text_previous_benchmark_results"></span>              <input type="checkbox" id="checkbox_previousrun_fps" onclick="return ToggleFPSHistory();">              <span class="checkbox_custom_checkmark"></span>            </label>          </div>        </div>        <div id="innerUpperRight">          <div style="width:80%;">            <div id="sysResTextHead" style="display: inline-block;width:25%;">                FPS RESULTS            </div>            <div class="sysResTextSmall">              <p><span id="text_fps_total_frames"></span></p>            </div>          </div>          <div id="separator_line_big" class=""></div>          <div style="width:80%; display: inline-block;">            <div style="display: inline-block; min-width: 200px; float: left;">              <p class="text_fps_avg"><span id="text_fps_avg"></span></p>              <div class="tooltipDiffFPS">                <img id="img_fps_avg_diff" src="" style="margin-left:1%; width: 25px;">                <p class="text_fps_diff"><span id="text_fps_avg_diff"></span></p><div class="tooltipArrowUp"></div><span class="tooltiptextDiff">Difference From Last Test</span>              </div>            </div>            <!-- padding FPS avg -- FPS Min/Max  -->            <div style="display: inline-block; min-width: 220px; margin-top: 15px; float: left;">              <div id="" style="display:inline-block; min-width: 100px;">                <p class="text_caption_fps_min_max"><span id="local_text_min_fps">MIN FPS</span></p>                <div style="">                  <span id="text_fps_min" class="text_fps_min_max"></span>                  <div class="tooltipDiffFPS">                    <img id="img_fps_min_diff" style="margin-left:5%; width: 25px;">                    <span id="text_fps_min_diff" class="text_fps_diff"></span><div class="tooltipArrowUp"></div><span class="tooltiptextDiff">Difference From Last Test</span>                  </div>                </div>              </div>              <!-- padding Min/Max -->              <div id="" style="display:inline-block; min-width: 100px; margin-left:5%">                <p class="text_caption_fps_min_max"><span id="local_text_max_fps">MAX FPS</span></p>                <div style="">                  <span id="text_fps_max" class="text_fps_min_max"></span>                  <div class="tooltipDiffFPS">                    <img id="img_fps_max_diff" style="margin-left:5%; width: 25px;">                    <span id="text_fps_max_diff" class="text_fps_diff"></span><div class="tooltipArrowUp"></div><span class="tooltiptextDiff">Difference From Last Test</span>                  </div>                </div>              </div>            </div>          </div>          <!-- <p>test end</p> -->          <div id="sysResTextHead" style="margin-top: 20px;">            <p><span id="local_text_system_resources">SYSTEM RESOURCES</span></p>          </div>          <div id="separator_line_big"></div>          <div id="sysResMainBlock">            <!-- MAIN Block -->            <!-- padding GPU LOAD -->            <p><span id="local_text_cpu_load" class="sysResResourceCaption">CPU LOAD</span></p>            <div class="container_cpu_load_div" style="width: 100%; position:relative; ">              <canvas id="canvas_cpu_load" style="width: 100%; height:auto; max-height: 50px; min-height: 30px; display: inline-block;"></canvas>              <div class="tooltipDiff"><span id="number_diff_cpu_load" class="sysResNumberPercentageDiff"></span><div class="tooltipArrowUp"></div><span class="tooltiptextDiff">Difference From Last Test</span></div>            </div>            <!-- GPU LOAD -->            <div style="width:100%;">              <div class="sysResResourceCaption" style="display: inline-block;width:25%;">                <p><span id=local_text_gpu_load>GPU LOAD</span></p>              </div>              <div class="sysResTextSmall">                <p><span id="text_sys_gpu_temp" style="margin: 0 0px 0 0; float:right;"></span></p>              </div>            </div>            <div style="position:relative;">              <canvas id="canvas_gpu_load" style="width: 100%