PointsFPS1[i]; //don't forget to add the base      }      _avg_fps1 = Math.floor(sumFPS1 / dataPointsFPS1.length);    }    else    {      _min_fps1 = -1.0;      _max_fps1 = -1.0;	  document.getElementById('checkbox_custom_outer_container').style.visibility = 'hidden';      document.getElementById('innerBottomSystemOptionsChangelist').style.visibility = 'hidden';    }    _max_fps = Math.floor(_max_fps);    _max_fps1 = Math.floor(_max_fps1);    _min_fps = Math.floor(_min_fps);    _min_fps1 = Math.floor(_min_fps1);    // # GPU DATA ANALYSIS    var sumGPUTime = 0;    for (var i = 0; i < dataPointsGPU_time.length; i++) {      sumGPUTime += dataPointsGPU_time[i]; //don't forget to add the base    }    const _avg_gpu_time = (sumGPUTime / dataPointsGPU_time.length).toFixed(1);    // # СPU DATA ANALYSIS    var sumCPUTime = 0;    for (var i = 0; i < dataPointsCPU_time.length; i++) {      sumCPUTime += dataPointsCPU_time[i]; //don't forget to add the base    }    const _avg_cpu_time = (sumCPUTime / dataPointsCPU_time.length).toFixed(1);    const _frames = 2050;    // ##################    // # RESOURCE USAGE    // # CPU LOAD    const _total_cpu_load = 49;    const  _total_cpu_load_prev = -1.0;    const _total_cpu_load_text = "49%";    // ## GPU LOAD    const _gpu_load = 99;    const  _gpu_load_prev = -1.0;    const _gpu_load_text = "99%";    // ## VRAM    const _vram_used = 1.54;    const  _vram_used_prev = -1.0;    const _vram_load_text = "78%";    // in percentage    const _vram_load = (_vram_used * 100) / _sys_vram_total;    const _vram_load_prev = _vram_used_prev != -1.0 ? (_vram_used_prev * 100) / _sys_vram_total : -1.0;    // ## RAM    const _ram_used = 4.24;    const  _ram_used1 = -1.0;    const _ram_load_text = "26%";    // in percentage    const _ram_load = (_ram_used * 100) / _sys_ram_total;    const _ram_load_prev = _vram_used_prev != -1.0 ? (_ram_used1 * 100) / _sys_ram_total : -1.0;    // ## TEMPERATURE    const _gpu_temperature = 90;    // Prepare HTML    document.getElementById('text_fps_avg').innerHTML = _avg_fps;    const _avg_fps_diff = (_avg_fps1 != -1.0) ? (_avg_fps - _avg_fps1) : 0;    document.getElementById('text_fps_min').innerHTML = _min_fps;    const _min_fps_diff = (_min_fps1 != -1.0) ? (_min_fps - _min_fps1) : 0;    document.getElementById('text_fps_max').innerHTML = _max_fps;    const _max_fps_diff = (_max_fps1 != -1.0) ? (_max_fps - _max_fps1) : 0;    document.getElementById('text_fps_total_frames').innerHTML = "Total Frames Rendered : " + _frames;    // FPS - Diff    if (_avg_fps_diff > 0) {      document.getElementById('img_fps_avg_diff').src = arrowGreenUpImgSrc;      document.getElementById('text_fps_avg_diff').innerHTML = _avg_fps_diff;    }    else if (_avg_fps_diff < 0) {      document.getElementById('img_fps_avg_diff').src = arrowRedDownImgSrc;      document.getElementById('text_fps_avg_diff').innerHTML = -_avg_fps_diff;    }    else {      document.getElementById('img_fps_avg_diff').src = arrowNoChangeImgSrc;      document.getElementById('text_fps_avg_diff').innerHTML = "0";    }    // FPS - Diff - Min    if (_min_fps_diff > 0) {      document.getElementById('img_fps_min_diff').src = arrowGreenUpImgSrc;      document.getElementById('text_fps_min_diff').innerHTML = _min_fps_diff;    }    else if (_min_fps_diff < 0) {      document.getElementById('img_fps_min_diff').src = arrowRedDownImgSrc;      document.getElementById('text_fps_min_diff').innerHTML = -_min_fps_diff;    }    else {      document.getElementById('img_fps_min_diff').src = arrowNoChangeImgSrc;      document.getElementById('text_fps_min_diff').innerHTML = "0";    }    // FPS - Diff - Max    if (_max_fps_diff > 0) {      document.getElementById('img_fps_max_diff').src = arrowGreenUpImgSrc;      document.getElementById('text_fps_max_diff').innerHTML = _max_fps_diff;    }    else if (_max_fps_diff < 0) {      document.getElementById('img_fps_max_diff').src = arrowRedDownImgSrc;      document.getElementById('text_fps_max_diff').innerHTML = -_max_fps_diff;    }    else {      document.getElementById('img_fps_max_diff').src = arrowNoChangeImgSrc;      document.getElementById('text_fps_max_diff').innerHTML = "0";    }    // Resource Usage - Telemetry    document.getElementById('text_sys_gpu_temp').innerHTML = decodeHtml("GPU Temperature " + _gpu_temperature + ' &#8451;');    document.getElementById('text_sys_vram').innerHTML = _vram_used.toFixed(2) + ' GB / ' + _sys_vram_total.toFixed(2) + ' GB';    document.getElementById('text_sys_ram').innerHTML = _ram_used.toFixed(2) + ' GB / ' + _sys_ram_total.toFixed(2) + ' GB';    // Main Setup    async function setup() {      setupHorizontalBars();      setupMainCharts();    }    // Setup HorizontalBar Charts    function setupHorizontalBars() {      // Chart Horizontal Bar - ## CPU LOAD      window.chart_cpu_load = createChartHorizontalBar("canvas_cpu_load", 'CPU LOAD', _total_cpu_load, _total_cpu_load_text);      document.getElementById('number_diff_cpu_load').innerHTML = "0%";      //setupChartDataTendencies('number_diff_cpu_load', -1, _total_cpu_load, _total_cpu_load_prev);      // Chart Horizontal Bar - ## GPU LOAD      window.chart_gpu_load = createChartHorizontalBar("canvas_gpu_load", 'GPU LOAD', _gpu_load, _gpu_load_text);      document.getElementById('number_diff_gpu_load').innerHTML = "0%";      //setupChartDataTendencies('number_diff_gpu_load', -1, _gpu_load, _gpu_load_prev);      // Chart Horizontal Bar - ## VRAM      window.chart_vram = createChartHorizontalBar("canvas_vram", 'VRAM', _vram_load.toFixed(0), _vram_load_text);      document.getElementById('number_diff_vram_load').innerHTML = "0%";      //setupChartDataTendencies('number_diff_vram_load', _sys_vram_total, _vram_used, _vram_used_prev);      // Chart Horizontal Bar - ## RAM      window.chart_ram = createChartHorizontalBar("canvas_ram", 'RAM', _ram_load, _ram_load_text);      document.getElementById('number_diff_ram_load').innerHTML = "0%";      //setupChartDataTendencies('number_diff_ram_load', _sys_ram_total, _ram_load, _ram_load_prev);    }    // ## Setup Chart tendencies like Arrows    //function setupChartDataTendencies(inElementID, inResAvailable, inResUsageCurrent, inResUsagePrev) {    //  if(inResUsagePrev == -1.0) {    //    document.getElementById(inElementID).innerHTML = "0%";    //    return;    //  }	//    //  var percentage = 0;    //  var percentageCurrent = 0;    //  var percentagePrev = 0;	//    //  if (inResAvailable > 0) {    //    percentageCurrent = ((inResUsageCurrent * 100) / inResAvailable).toFixed(0);    //    percentagePrev = ((inResUsagePrev * 100) / inResAvailable).toFixed(0);    //  }    //  else {    //    percentageCurrent = ((inResUsageCurrent * 100) / 100).toFixed(0);    //    percentagePrev = ((inResUsagePrev * 100) / 100).toFixed(0);    //  }	//    //  if (percentageCurrent > percentagePrev) {    //    percentage = -(percentageCurrent - percentagePrev);    //  }    //  else if (percentagePrev > percentageCurrent) {    //    percentage = percentagePrev - percentageCurrent;    //  }	//    //  if (percentage != 0) {	//	percentage = -percentage;    //    document.getElementById(inElementID).innerHTML = (percentage > 0 ? '+' : '') + percentage + '%';    //  }    //  else {    //    document.getElementById(inElementID).innerHTML = "0%";    //  }    //}    // Setup Charts    function setupMainCharts() {      // Chart main - ## FPS      window.chart_main_fps = createChartLine("canvas_main_fps", "FPS", _avg_fps, dataPointsFPS, dataPointsFPS1);      // Chart main - ## GPU TIME (MS)      window.chart_main_gpu_time = createChartLine("canvas_main_gpu_time", "GPU TIME (MS)", _avg_gpu_time, dataPointsGPU_time, dataPointsGPU_time1);      // Chart main - ## CPU TIME (MS)      window.chart_main_cpu_time = createChartLine("canvas_main_cpu_time", "CPU TIME (MS)", _avg_cpu_time, dataPointsCPU_time, dataPointsCPU_time1);      //console.log(window.chart_main_cpu_time);    }    /////////////////////////////////////////////////////////////////////////////////    // ### Chart - Horizontal Bar Custom ###    Chart.defaults.derivedHorizontalBar = Chart.defaults.horizontalBar;    var customHorizontalBar = Chart.controllers.horizontalBar.extend({      draw: function (ease) {        Chart.controllers.bubble.prototype.draw.call(this, ease);      }    });    Chart.controllers.derivedHorizontalBar = customHorizontalBar;    // ## Chart - register custom methods for Horizontal Bar ##    Chart.pluginService.register({      afterDraw: function (chart) {        // To display - Resource usage on the chart        var width = chart.chart.width;        var height = chart.chart.height;        var ctx = chart.chart.ctx;        var type = chart.config.type;        if (type == 'derivedHorizontalBar') {          ctx.font = "28px ScoutCond";          ctx.fillStyle = "#ffffff";          ctx.textBaseline = 'middle';          //const usedInpercent = parseInt(chart.config.data.datasets[0].data[0]);          const text = chart.config.data.datasets[0].label;          const textX = Math.round((width - ctx.measureText(text).width) / 2);          const textY = (height + chart.chartArea.top) / 2;          ctx.fillText(text, textX, textY);          ctx.save();        }      },    });    // ## Create new Horizontal Bar chart ##    function createChartHorizontalBar(inCanvas, inLabelName, inPercentage, percentage_text) {      const ctx = document.getElementById(inCanvas).getContext('2d');      var _backgroundColor = '#94c11e';      var _reminder = 100 - inPercentage;      if (_reminder <= 0) {        _backgroundColor = '#f80303'; // RED        _reminder = 0;      }      // # Chart Options      var horizontalBarOptions = {        responsive: false,        maintainAspectRatio: false,        title: {          display: false,          text: '',          fontStyle: 'bold',          padding: 0,        },        tooltips: {          enabled: false,        },        legend: {          display: false        },        animation: {          duration: 0        },        scales: {          xAxes: [{            barPercentage: 1.0,            categoryPercentage: 1.0,            stacked: true,            gridLines: {              display: false,              drawBorder: false,              tickMarkLength: 0,              drawTicks: false,            },            ticks: {              display: false,              min: 0,              max: 100,              beginAtZero: false,              maxTicksLimit: 1,            },          }],          yAxes: [{            barPercentage: 1.0,            categoryPercentage: 1.0,            stacked: true,            gridLines: {              display: false,              drawBorder: false,              tickMarkLength: 0,              offset: false,              drawTicks: false,            },            ticks: {              display: false,              min: 0,              max: 100,              beginAtZero: false,              maxTicksLimit: 1,            },          }]        },      };      // # Chart Config      var config = {        type: 'derivedHorizontalBar',        data: {          labels: [inLabelName],          datasets: [            {              label: percentage_text,              data: [inPercentage],              backgroundColor: [_backgroundColor],              borderWidth: 1            },            {              label: 'Reminder',              data: [_reminder],              backgroundColor: '#333740',            }          ]        },        options: horizontalBarOptions      };      const myChart = new Chart(ctx, config);      return myChart;    }    /////////////////////////////////////////////////////////////////////////////////    // ### Chart - Line Chart: FPS, CPU TIME, GPU Time ###    Chart.defaults.derivedLine = Chart.defaults.line;    var customLine = Chart.controllers.line.extend({      draw: function (ease) {        Chart.controllers.line.prototype.draw.call(this, ease);        // Drawing dashes line + circles        if (this.chart.tooltip._active && this.chart.tooltip._active.length) {          const activePoint = this.chart.tooltip._active[0];          const ctx = this.chart.ctx;          const topY = this.chart.scales['y-axis-0'].top;          const bottomY = this.chart.scales['y-axis-0'].bottom;          const leftX = this.chart.scales['x-axis-0'].left;          const rightX = this.chart.scales['x-axis-0'].right;          var x = activePoint.tooltipPosition().x;          if (x >= rightX)          {            return;          }          //var y = activePoint.tooltipPosition().y;          // Drawing dashes line + greyscale shadow          {            var originalStroke = ctx.stroke;            grad_size = 60;            const grad_pos = x + grad_size;            if (grad_pos > rightX) {              grad_size = rightX - x;            }            var grd=ctx.createLinearGradient(x, topY, x + grad_size, topY);            grd.addColorStop(0, "rgba(100, 100, 100, 0.1)");            grd.addColorStop(1, "rgba(100, 100, 100, 0)");            ctx.fillStyle = grd;            ctx.fillRect(x, topY, grad_size, bottomY - 9);            // ctx.stroke = function () {            //   ctx.save();            //   ctx.shadowColor = '#999';            //   ctx.shadowBlur = 30;            //   ctx.shadowOffsetX = 15;            //   ctx.shadowOffsetY = 0;            //   originalStroke.apply(this, arguments)            //   ctx.restore();            // }            ctx.save();            ctx.setLineDash([16, 3]); //dashes are 5px and spaces are 3px            ctx.beginPath();            ctx.moveTo(x, topY);            ctx.lineTo(x, bottomY);            ctx.lineWidth = 2;            ctx.strokeStyle = '#07C';            ctx.stroke();            ctx.restore();            // Drawing shadow - End            ctx.stroke = originalStroke;          }          // Begin - Drawing custom tooltips          const valueAlpha = 0.3;          const origAlpha = ctx.globalAlpha;          {            // Handle the label position on the chart            const labelPaddingX = 5, labelPaddingY = 5;            const halfChartWidth = (topY - bottomY) / 2;            var offsetAPY = bottomY + (halfChartWidth / 2) - 30;            var offsetAPX = x + labelPaddingX;            var offsetAPPrevY = (halfChartWidth / 2) + bottomY;            var offsetAPPrevX = x + labelPaddingX;            if (activePoint.tooltipPosition().y > (bottomY + halfChartWidth)) {              offsetAPY = bottomY + (halfChartWidth * 2) + 10;              offsetAPPrevY = bottomY + halfChartWidth + (halfChartWidth / 2);            }            if ((this.chart.tooltip._active.length > 1) && (this.chart.config.data.datasets.length > 1) && (this.chart.config.data.datasets[1].showLine)) {              const activePointPrev = this.chart.tooltip._active[1]              // Draw circle - prev              ctx.beginPath();              ctx.arc(activePointPrev.tooltipPosition().x, activePointPrev.tooltipPosition().y, 5, 0, 2 * Math.PI, false);              ctx.fillStyle = this.chart.config.data.datasets[1].borderColor;              ctx.fill();              ctx.restore();              // Draw custom label - prev              var labelText = this.chart.config.data.datasets[1].label[0] + ': ';              labelText += this.chart.data.datasets[activePointPrev._datasetIndex].data[activePointPrev._index];              ctx.font = this.chart.options.tooltips.titleFontStyle + " " + this.chart.options.tooltips.titleFontSize + "px Arial";              const xPad = this.chart.options.tooltips.xPadding;              const yPad = this.chart.options.tooltips.yPadding;              const textWidth = ctx.measureText(labelText).width + xPad * 2;              const height = this.chart.options.tooltips.titleFontSize + yPad * 2;              const radius = this.chart.options.tooltips.cornerRadius;              //console.log("chart",this.chart, activePointPrev, topY, xPad, yPad, ctx.font);              ctx.fillStyle = this.chart.options.tooltips.backgroundColor;              ctx.lineWidth = this.chart.options.tooltips.borderWidth;              if (offsetAPPrevX + textWidth > rightX) {                offsetAPPrevX -= textWidth + (labelPaddingX * 2);              }              ctx.globalAlpha = valueAlpha;              // Draw rect upper tooltip              {                ctx.beginPath();                ctx.moveTo(offsetAPPrevX + radius, offsetAPPrevY);                ctx.lineTo(offsetAPPrevX + textWidth - radius, offsetAPPrevY);                ctx.quadraticCurveTo(offsetAPPrevX + textWidth, offsetAPPrevY, offsetAPPrevX + textWidth, offsetAPPrevY + radius);                ctx.lineTo(offsetAPPrevX + textWidth, offsetAPPrevY + height - radius);                ctx.quadraticCurveTo(offsetAPPrevX + textWidth, offsetAPPrevY + height, offsetAPPrevX + textWidth - radius, offsetAPPrevY + height);                ctx.lineTo(offsetAPPrevX + radius, offsetAPPrevY + height);                ctx.quadraticCurveTo(offsetAPPrevX, offsetAPPrevY + height, offsetAPPrevX, offsetAPPrevY + height - radius);                ctx.lineTo(offsetAPPrevX, offsetAPPrevY + radius);                ctx.quadraticCurveTo(offsetAPPrevX, offsetAPPrevY, offsetAPPrevX + radius, offsetAPPrevY);                ctx.closePath();                ctx.fill();                // return alpha to the original state before draw the label's text                ctx.globalAlpha = origAlpha;                // Draw text                ctx.textBaseline = 'top';                ctx.fillStyle = this.chart.config.data.datasets[1].borderColor;                ctx.fillText(labelText, offsetAPPrevX + xPad, offsetAPPrevY + yPad);              }            }            // Draw Custom tooltips            var labelText = this.chart.config.data.datasets[0].label[0] + ': ';            labelText += this.chart.data.datasets[activePoint._datasetIndex].data[activePoint._index];            ctx.font = this.chart.options.tooltips.titleFontStyle + " " + this.chart.options.tooltips.titleFontSize + "px Arial";            const xPad = this.chart.options.tooltips.xPadding;            const yPad = this.chart.options.tooltips.yPadding;            const textWidth = ctx.measureText(labelText).width + xPad * 2;            const height = this.chart.options.tooltips.titleFontSize + yPad * 2;            const radius = this.chart.options.tooltips.cornerRadius;            //console.log("tooltips",this.chart.options, activePoint, topY, xPad, yPad, ctx.font);            ctx.fillStyle = this.chart.options.tooltips.backgroundColor;            ctx.lineWidth = this.chart.options.tooltips.borderWidth;            // Flip current label if it overlapped a chart border            if (offsetAPX + textWidth > rightX) {              offsetAPX -= textWidth + (labelPaddingX * 2);            }            ctx.globalAlpha = valueAlpha;            // Draw rect tooltip            {              ctx.beginPath();              ctx.moveTo(offsetAPX + radius, offsetAPY);              ctx.lineTo(offsetAPX + textWidth - radius, offsetAPY);              ctx.quadraticCurveTo(offsetAPX + textWidth, offsetAPY, offsetAPX + textWidth, offsetAPY + radius);              ctx.lineTo(offsetAPX + textWidth, offsetAPY + height - radius);              ctx.quadraticCurveTo(offsetAPX + textWidth, offsetAPY + height, offsetAPX + textWidth - radius, offsetAPY + height);              ctx.lineTo(offsetAPX + radius, offsetAPY + height);              ctx.quadraticCurveTo(offsetAPX, offsetAPY + height, offsetAPX, offsetAPY + height - radius);              ctx.lineTo(offsetAPX, offsetAPY + radius);              ctx.quadraticCurveTo(offsetAPX, offsetAPY, offsetAPX + radius, offsetAPY);              ctx.closePath();              ctx.fill();              // Return alpha to the original state before draw the label's text              ctx.globalAlpha = origAlpha;              // Draw text              ctx.textBaseline = 'top';              ctx.fillStyle = this.chart.config.data.datasets[0].borderColor;              ctx.fillText(labelText, offsetAPX + xPad, offsetAPY + yPad);            }            // Draw circle - current            ctx.beginPath();            ctx.arc(activePoint.tooltipPosition().x, activePoint.tooltipPosition().y, 5, 0, 2 * Math.PI, false);            ctx.fillStyle = this.chart.config.data.datasets[0].borderColor;            ctx.fill();            ctx.lineWidth = 2;            ctx.restore();          } // End - Drawing two tooltips        }      }    });    Chart.controllers.derivedLine = customLine;    Chart.Tooltip.positioners.custom = function (elements, eventPosition) {      var tooltip = this;      return {        x: eventPosition.x,        y: elements[0]._chart.height      };    }    //////////////////////    // Horizontal line plugin    var horizonalLinePlugin = {      beforeDraw: function (chartInstance) {        const yScale = chartInstance.scales["y-axis-0"];        const canvas = chartInstance.chart;        var ctx = canvas.ctx;        var index;        var line;        var style;        // Fill chart area color        if (chartInstance.config.options.chartArea && chartInstance.config.options.chartArea.backgroundColor) {          var helpers = Chart.helpers;          var ctx = chartInstance.chart.ctx;          var chartArea = chartInstance.chartArea;          ctx.save();          ctx.fillStyle = chartInstance.config.options.chartArea.backgroundColor;          ctx.fillRect(chartArea.left, chartArea.top, chartArea.right - chartArea.left, chartArea.bottom - chartArea.top);          ctx.restore();        }        if (chartInstance.options.horizontalLine) {          for (index = 0; index < chartInstance.options.horizontalLine.length; index++) {            line = chartInstance.options.horizontalLine[index];            if (!line.style) {              if (line.text == "FPS") {                style = "#36a9e1";              }              else {                style = "#70747c";              }            } else {              style = line.style;            }            if (line.y) {              yValue = yScale.getPixelForValue(line.y);            } else {              yValue = 0;            }            ctx.lineWidth = 2;            if (yValue) {              ctx.beginPath();              const paddingStart = 72;              const paddingEnd = 90;              ctx.moveTo(paddingStart, yValue);              ctx.lineTo(canvas.width - paddingEnd, yValue);              ctx.strokeStyle = style;              ctx.stroke();            };            if (line.text) {              const chartEndPos = canvas.width - chartInstance.options.layout.padding.right + 40;                            // Measuring the size of the rectangle              const textLabelCaption = "AVERAGE TIME";              const textLabelCaptionEng = "AVERAGE TIME";              var size = 20;              var font = size + "pt ScoutCond";              ctx.font = font;              const labelCaptionWidth = ctx.measureText(textLabelCaptionEng).width;              var width = ctx.measureText(textLabelCaption).width;              if (width > labelCaptionWidth)              {                while(width > labelCaptionWidth)                {                  size = size - 1;                  font = size + "pt ScoutCond";                  ctx.font = font;                  width = ctx.measureText(textLabelCaption).width;                }              }              else if (width < labelCaptionWidth)              {                while(width < labelCaptionWidth)                {                  size = size + 1;                  font = size + "pt ScoutCond";                  ctx.font = font;                  width = ctx.measureText(textLabelCaption).width;                }              }              const realLabelCaptionWidth = ctx.measureText(textLabelCaption).width;              ctx.font = "14pt ScoutCond";              const textEndingMS = "MS";              const endingMSWidth = ctx.measureText(textEndingMS).width;              ctx.font = "45pt ScoutCond";              const textNumber = (chartInstance.config.data.labels[0].length == 1 ? _avg_gpu_time : _avg_cpu_time);              const numberWidth = ctx.measureText(textNumber).width;              const paddingX = 3, paddingY = 10, offsetTop = 10, spaceX = 5;              const textNumberWidth = Math.max(ctx.measureText(_avg_gpu_time).width, ctx.measureText(_avg_cpu_time).width) + endingMSWidth + spaceX;              var longestTextWidth = (realLabelCaptionWidth > textNumberWidth ? realLabelCaptionWidth : textNumberWidth);              var longestTextCenterPos = chartEndPos + (longestTextWidth / 2);              // Recalculate in a case of the text will be longer than the width of the box Size              var boxSizeWidth = longestTextWidth + 2 * paddingX;              var centerBoxPosX = chartEndPos + (boxSizeWidth / 2);              const boxSizeHeight = boxSizeWidth;              const startBoxPosY = yValue - (boxSizeHeight / 2);              if (chartInstance.config.data.labels[0].length != 0) {                // Drawing grey rectangle                ctx.fillStyle = "#70747c";                ctx.fillRect(chartEndPos, startBoxPosY, boxSizeWidth, boxSizeHeight);                // Drawing caption - "GPU TIME" / "CPU TIME"                ctx.fillStyle = "rgba(255,255,255, 1)";                ctx.font = font;                ctx.textBaseline = "top";                ctx.fillText(textLabelCaption, centerBoxPosX - realLabelCaptionWidth / 2, startBoxPosY + offsetTop);                // Drawing average Number of CPU/GPU TIME                ctx.font = "45pt ScoutCond";                ctx.textBaseline = "middle";                ctx.fillText(textNumber, centerBoxPosX - (numberWidth + endingMSWidth +