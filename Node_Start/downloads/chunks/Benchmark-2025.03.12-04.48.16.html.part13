ay: none;"    src="data:image/png;base64," />  <script>    // var showPrevResults = false;    // window.sessionStorage.setItem("showPrevResultsKey", showPrevResults);    window.addEventListener('load', setup);    // #### Helpers functions    function decodeHtml(html) {      var txt = document.createElement("textarea");      txt.innerHTML = html;      return txt.value;    }    function getRandom(min, max) {      return Math.random() * (max - min) + min;    }    function getRandomInt(min, max) {      min = Math.ceil(min);      max = Math.floor(max);      return Math.floor(Math.random() * (max - min + 1)) + min;    }    function randomDataSet(dataSetSize, minValue, maxValue) {      return new Array(dataSetSize).fill(0).map(function (n) {        return Math.floor( (Math.random() * (maxValue - minValue) + minValue) * 10) / 10.0;      });    }    function randomDataSetInt(dataSetSize, minValue, maxValue) {      return new Array(dataSetSize).fill(0).map(function (n) {        return getRandomInt(minValue, maxValue);      });    }    // #### GLOBAL VARS    // https://www.base64-image.de/    const arrowRedUpImgSrc = "data:image/png;base64,";    const arrowRedDownImgSrc = "data:image/png;base64,";    const arrowGreenUpImgSrc = "data:image/png;base64,";    const arrowGreenDownImgSrc = "data:image/png;base64,";    const arrowNoChangeImgSrc = "data:image/png;base64,";    // ######################    // # MAIN CHARTS - DATA    //var limit = 99; //increase number of dataPoints by increasing this    // FPS    //var dataPointsFPS = [140, 142, 116, 145, 148, 150, 151, 149, 115, 110, 94, 97, 95, 105, 109, 119, 139, 158, 160, 157, 151, 156, 159, 158, 161, 173, 177, 175];//randomDataSetInt(limit, 70, 80);    //var dataPointsFPS1 = [135, 140, 113, 140, 140, 155, 149, 150, 107, 113, 92, 95, 98, 101, 107, 129, 135, 137, 150, 155, 161, 169, 173, 189, 188, 185, 190, 187];//randomDataSetInt(limit, 70, 80);    // GPU TIME    //var dataPointsGPU_time = randomDataSet(limit, 5, 15);    //var dataPointsGPU_time1 = randomDataSet(limit, 5, 15);    // CPU TIME    //var dataPointsCPU_time = randomDataSet(limit, 5, 16);    //var dataPointsCPU_time1 = randomDataSet(limit, 5, 16);    var show_prev_label = "PREVIOUS BENCHMARK RESULTS";        var canvas = document.createElement('canvas');    var ctx = canvas.getContext('2d');    ctx.font = "1.4vw ScoutCond";        var checkbox_width = Math.floor(ctx.measureText(show_prev_label).width * 1.2) + 25;    var attribute_text = "width:" + checkbox_width + "px";    document.getElementById('checkbox_custom_outer_container').setAttribute("style", attribute_text);    document.getElementById('local_text_previous_benchmark_results').innerHTML = show_prev_label;        var display_label = "DISPLAY";    document.getElementById('local_text_display').innerHTML = BuyukHarfBlur(display_label);    var overall_quality_label = "Overall Quality";    document.getElementById('local_text_overall_quality').innerHTML = BuyukHarfBlur(overall_quality_label);    var window_mode_label = "Display Mode";    document.getElementById('local_text_window_mode').innerHTML = BuyukHarfBlur(window_mode_label);    var texture_quality_label = "Texture Quality";    document.getElementById('local_text_texture_quality').innerHTML = BuyukHarfBlur(texture_quality_label);    var aspect_ratio_label = "Aspect Ratio";    document.getElementById('local_text_aspect_ratio').innerHTML = BuyukHarfBlur(aspect_ratio_label);    var texture_filtering_label = "Texture Filtering";    document.getElementById('local_text_texture_filter').innerHTML = BuyukHarfBlur(texture_filtering_label);    var resolution_label = "Resolution";    document.getElementById('local_text_resolution').innerHTML = BuyukHarfBlur(resolution_label);    var lod_label = "LOD Quality";    document.getElementById('local_text_lod_quality').innerHTML = BuyukHarfBlur(lod_label);    var refresh_rate_label = "Refresh Rate";    document.getElementById('local_text_refresh_rate').innerHTML = BuyukHarfBlur(refresh_rate_label);    var shading_quality_label = "Shading Quality";    document.getElementById('local_text_shading_quality').innerHTML = BuyukHarfBlur(shading_quality_label);    var letterbox_label = "Widescreen Letterbox";    document.getElementById('local_text_letterbox').innerHTML = BuyukHarfBlur(letterbox_label);    var shadow_quality_label = "Shadow Quality";    document.getElementById('local_text_shadow_quality').innerHTML = BuyukHarfBlur(shadow_quality_label);    var vsync_label = "VSync";    document.getElementById('local_text_v_sync').innerHTML = BuyukHarfBlur(vsync_label);    var reflection_label = "Reflection Quality";    document.getElementById('local_text_reflection').innerHTML = BuyukHarfBlur(reflection_label);    var fov_label = "Field of View";    document.getElementById('local_fov').innerHTML = BuyukHarfBlur(fov_label);    var ambient_occlusion_label = "Ambient Occlusion";    document.getElementById('local_text_ambient_occulusion').innerHTML = BuyukHarfBlur(ambient_occlusion_label);    var lens_effect_label = "Lens Effects";    document.getElementById('local_text_lens_effect').innerHTML = BuyukHarfBlur(lens_effect_label);    var zoom_deps_of_field_label = "Zoom-In Depth of Field";    document.getElementById('local_text_zoom_deps_of_field').innerHTML = BuyukHarfBlur(zoom_deps_of_field_label);    var anti_aliasing_label = "Anti Aliasing Quality";    document.getElementById('local_text_anti_aliasing').innerHTML = BuyukHarfBlur(anti_aliasing_label);    var taa_sharpness_label = "T-AA Sharpness";    document.getElementById('local_text_taa_sharpness').innerHTML = BuyukHarfBlur(taa_sharpness_label);    var scaling_label = "RENDER SCALING";    document.getElementById('local_text_scaling').innerHTML = BuyukHarfBlur(scaling_label);            var display = "1 - ";    var display1 = "-";    document.getElementById('monitor_display').innerHTML =