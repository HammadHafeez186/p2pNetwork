 spaceX) / 2, yValue + paddingY);                // Drawing ending MS                ctx.font = "14pt ScoutCond";                ctx.textBaseline = "top";                ctx.fillText(textEndingMS, (centerBoxPosX - (numberWidth + endingMSWidth + spaceX)/ 2) + numberWidth + spaceX, yValue + paddingY);              }              else {                // Measuring the size of the rectangle                const textLabelCaption = "AVERAGE FPS";                const textLabelCaptionEng = "AVERAGE FPS"                var size = 20;                var font = size + "pt ScoutCond";                ctx.font = font;                const labelCaptionWidth = ctx.measureText(textLabelCaptionEng).width;                var width = ctx.measureText(textLabelCaption).width;                if (width > labelCaptionWidth)                {                  while(width > labelCaptionWidth)                  {                    size = size - 1;                    font = size + "pt ScoutCond";                    ctx.font = font;                    width = ctx.measureText(textLabelCaption).width;                  }                }                else if (width < labelCaptionWidth)                {                  while(width < labelCaptionWidth)                  {                    size = size + 1;                    font = size + "pt ScoutCond";                    ctx.font = font;                    width = ctx.measureText(textLabelCaption).width;                  }                }                ctx.font = "45pt ScoutCond";                const labelNumberWidth = ctx.measureText(_avg_fps).width;                const paddingX = 10, paddingY = 10;                const boxSizeWidthBlue = boxSizeWidth;//(labelCaptionWidth > labelNumberWidth ? labelCaptionWidth : labelNumberWidth) + 2 * paddingX;                const boxSizeHeight = boxSizeWidthBlue;                const startBoxPosY = yValue - (boxSizeHeight / 2);                const centerBoxPosX = chartEndPos + (boxSizeWidthBlue / 2);                // Draw blue rectangle                ctx.fillStyle = "#36a9e1";                ctx.fillRect(chartEndPos, startBoxPosY, boxSizeWidthBlue, boxSizeHeight);                // Draw caption - OVERALL FPS                ctx.fillStyle = "rgba(255,255,255, 1)";                ctx.font = font;                ctx.textBaseline = "top";                ctx.fillText(textLabelCaption , centerBoxPosX - labelCaptionWidth / 2, startBoxPosY + paddingY);                // Draw average FPS                ctx.font = "45pt ScoutCond";                ctx.textBaseline = "middle";                ctx.fillText(_avg_fps, centerBoxPosX - labelNumberWidth / 2, yValue + paddingY);              };              ///////////////////////////////////////              // Draw vertical label              //console.log(chartInstance);              const height = chartInstance.canvas.height;              const halfChartWidth = Math.abs(height / 2);              ctx.fillStyle = "#A1A1A1";              size = 18;              font = size + "px ScoutRegular"              ctx.font = font;              ctx.textBaseline = "top";              width = ctx.measureText(line.text).width;              while (width > height)              {                size = size - 1;                font = size + "px ScoutRegular";                ctx.font = font;                width = ctx.measureText(line.text).width;              }              ctx.save();              ctx.translate(0, halfChartWidth + (width / 2));              // When we rotate the canvas X and Y coordinates are swapping              ctx.rotate(-0.5 * Math.PI);              ctx.fillText(line.text, 0, 0);              ctx.restore();              console.log(chartInstance.options.scales);              console.log(chartInstance.options.scales.yAxes.ticks);            }          }          return;        };      }    };    Chart.pluginService.register(horizonalLinePlugin);    function createChartLine(inCanvas, inLabelName, inAverageNum, inDataCurr, inDataPrev) {      const ctx = document.getElementById(inCanvas).getContext('2d');            var _min_fps= 9999;      var _max_fps = 0;      for (var i = 0; i < inDataCurr.length; i++) {        if (inDataCurr[i] < _min_fps) {          _min_fps = inDataCurr[i];        }        if (inDataCurr[i] > _max_fps) {          _max_fps = inDataCurr[i];        }      }      for (var i = 0; i < inDataPrev.length; i++) {        if (inDataPrev[i] < _min_fps) {          _min_fps = inDataPrev[i];        }        if (inDataPrev[i] > _max_fps) {          _max_fps = inDataPrev[i];        }      }      var sugMax = _max_fps;      var sugMin = _min_fps;      const coeff = 0.3;      if (coeff * (_max_fps - _min_fps) > inAverageNum - _min_fps) {        sugMin = (inAverageNum - coeff * _max_fps) / (1.0 - coeff);      }      if (_max_fps - inAverageNum < coeff * (_max_fps - _min_fps)) {        sugMax = (inAverageNum - coeff * _min_fps) / (1.0 - coeff);      }      const dummyLabelsFPS = new Array(inDataCurr.length).fill('');      const dummyLabelsGPU = new Array(inDataCurr.length).fill(' ');      const dummyLabelsCPU = new Array(inDataCurr.length).fill('  ');      // # Chart Options      var lineChartOptions = {        defaultFontFamily: Chart.defaults.global.defaultFontFamily = "'ScoutRegular'",        layout: {          padding: {            left: 0,            right: 230,            top: 0,            bottom: 0          }        },        //horizontalLine Plugin        "horizontalLine": [{          "y": inAverageNum,          "text": inLabelName,        }],        responsive: false,        chartArea: {          backgroundColor: '#191e24',        },        maintainAspectRatio: true,        elements: {          line: {            tension: 0          },          point: {            radius: 0          }        },        // Tooltips - hover mouse        hover: {          mode: 'nearest',          intersect: false        },        tooltips: {          enabled: false,          position: 'custom',          caretSize: 0,          mode: 'nearest',          intersect: false,          axis: 'x',          backgroundColor: '#000000',          titleFontSize: 12,          titleFontColor: '#FFFFFF',          bodyFontColor: '#000',          titleMarginBottom: 2,          displayColors: false        },        title: {          display: false,        },        legend: {          display: false        },        scales: {          xAxes: [{            display: false,            scaleLabel: {              display: false,            },          }],          yAxes: [{            display: true,            scaleLabel: {              display: true,              //fontSize: 22,              //labelString: inLabelName            },            ticks: {              // Vertical              suggestedMin: sugMin,              suggestedMax: sugMax,              fontSize: 18,              callback: function (value,index,values) {                  if(values[0] < 10)                    return value.toFixed(2);                                      if(values[0] < 100)                   return value.toFixed(1);                                     return value.toFixed(0);              }            },            gridLines: {              color: "#333740",              lineWidth: 1,              zeroLineColor: "#333740",              zeroLineWidth: 1,            },          }]        }      };      // # Chart Config      var config = {        type: 'derivedLine',        data: {          labels: (inCanvas == "canvas_main_fps") ? dummyLabelsFPS : ((inCanvas == "canvas_main_gpu_time") ? dummyLabelsGPU : dummyLabelsCPU),          borderColor: "rgba(255, 0, 0, 1)",          datasets: [            {              label: ['Latest'],              data: inDataCurr,              borderColor: "#fbc900",              showLine: true,              pointRadius: 0,              borderWidth: 0,              pointHoverRadius: 0, // to disable hover point              fill: false,            },            {              label: ['Previous'],              data: inDataPrev,              borderColor: "#70747c",              showLine: false,              pointRadius: 0,              borderWidth: 0,              pointHoverRadius: 0,              fill: false,            }],        },        options: lineChartOptions      };      const myChart = new Chart(ctx, config);      return myChart;    }    // Toggle Charts History    function ReloadChart(chart, curData, prevData, showPrev)    {      chart.data.datasets.splice(0, 1);      chart.data.datasets.splice(0, 1);      var cur = {          label: ['Latest'],          data: curData,          borderColor: "#fbc900",          showLine: true,          pointRadius: 0,          borderWidth: 0,          pointHoverRadius: 0, // to disable hover point          fill: false,        };      var prev = {        label: ['Previous'],        data: prevData,        borderColor: "#70747c",        showLine: showPrev,        pointRadius: 0,        borderWidth: 0,        pointHoverRadius: 0,        fill: false,      };            chart.data.datasets.push(cur);      chart.data.datasets.push(prev);      chart.update();    }    function ToggleFPSHistory() {      const checkbox = document.getElementById('checkbox_previousrun_fps');      ReloadChart(window.chart_main_fps, dataPointsFPS, dataPointsFPS1, checkbox.checked);      ReloadChart(window.chart_main_gpu_time, dataPointsGPU_time, dataPointsGPU_time1, checkbox.checked);      ReloadChart(window.chart_main_cpu_time, dataPointsCPU_time, dataPointsCPU_time1, checkbox.checked);    }  </script></body></html>