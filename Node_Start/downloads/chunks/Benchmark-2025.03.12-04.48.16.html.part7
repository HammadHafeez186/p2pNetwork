at the up */      ::-webkit-scrollbar-button:start:decrement {          background-image: url('data:image/png;base64,');          background-color: #333740;      }      ::-webkit-scrollbar-button {      background-size: 100%;      height: 10px;      width: 10px;    }         /* div {        border: 1px solid rgb(0, 0, 0);      } */        #bg {        position: fixed;         top: 0;         left: 0;         min-width: 100%;        min-height: 100%;      }        #base {        /* background-color: #2b343d; */        /* https://learn.javascript.ru/display */        display: inline-block;        position: relative;        /* overflow: auto;        overflow-x: hidden; */        height: 100%;        /* height: 1800px; */        width: 100%;        z-index: 0;      }        #mainContainer {        /* background-color: #2b343d; */        display: inline-block;        width:100%;      }        #header {        /* background-color: #2b343d; */        display: block;        height: 120px;        width: 100%;        margin-left: 70px;        /* width: inherit; */      }        /* UPPER */      #upper {        /* background-color: #2b343d; */        display: block;        width: 100%;        height: 50%;      }        #innerUpperLeft {        /* background-color: #2b343d; */        display: inline-block;        margin-left: 15pt;        width: 60%;        /* min-width: 1010px; */        height: 900px;      }        #innerUpperMiddle {        /* background-color: #ffffff; */        width: 15%;        display: inline-block;      }        #innerUpperRight {        /* background-color: #2b343d; */        /* display: inline-block; // will be ignored due to float attribute*/        float: right;        width: 34%;        /* min-width: 410px; */        /* visibility: hidden; */      }        /* BOTTOM */      #bottom {        /* background-color: #47c952; */        display: block;        width: 100%;        /* height: 50%; */      }        #innerBottomSystemOptions {        /* background-color: #2b343d; */        display: inline-block;        margin-left: 30pt;        margin-top: 30pt;        width: 55%;      }        #innerBottomSystemOptionsChangelist {        /* background-color: #2b343d; */        display: inline-block;        min-width: 200px;        width: 34%;        margin-top: 30pt;        float: right;                /* float: left; */      }        .chart_container {        /* background-color: #ffffff; */        position: relative;        display: block;        cursor: pointer;        /* width: 100%; */        height: auto;        margin-bottom: 14px;        /* min-width: 1000px; */      }        #chart_horizontal_caption {        /* border-width: 0px; */        position: relative;        font-family: 'ScoutRegular';        font-weight: 400;        font-style: normal;        font-size: 1.3vw;        color: #ffffff;        padding-top: 0;        /* line-height: 29px; */        margin-left: 72px;        /* margin-top: 10px; */      }        /* #################################### */      /* TITLE */      #header_img {        border-width: 0px;        display: inline-block;        position: relative;        /* left: 90px; */        top: 10px;        width: auto;        height: 76px;        border-width: 0px;        margin-left: 20px;        /* opacity: 0.3; */        color: #1E1E1E;      }        /* HEADER */      #header_benchmark {        border-width: 0px;        display: inline-block;        position: relative;        /* left: 60px; */        top: 0px;        /* margin-left: 70px; */        /* width: 169px; */        /* height: 36px; */        /* font-size: 36px; */        color: #ffffff;        /* line-height: 36px; */        white-space: nowrap;      }        #local_text_system_options_changelist {        font-family: ScoutCond;      }        #local_text_system_options {        font-family: ScoutCond;      }        .header_benchmark_line1 {        border-width: 0px;        position: relative;        /* left: 60px;        top: 0px; */        font-family: 'ScoutRegular';        width: 169px;        font-size: 29px;        line-height: 26px;        white-space: nowrap;      }        .header_benchmark_line2 {        border-width: 0px;        position: relative;        /* left: 60px;        top: 0px; */        font-family: 'ScoutCond';        width: 169px;        bottom: -7px;        font-size: 58px;        line-height: 39px;        white-space: nowrap;      }        /* TEXT - FPS  */        #separator_line_very_big {        border-width: 0px;        position: relative;        display: block;        left: 0px;        top: 0;        width: 80%;        height: 1px;        background: inherit;        background-color: #949494;        border: none;        border-radius: 0px;        -moz-box-shadow: none;        -webkit-box-shadow: none;        box-shadow: none;        opacity: 0.5;      }        /* u457_div*/      #separator_line_big {        border-width: 0px;        position: relative;        display: block;        left: 0px;        top: 0px;        width: 80%;        height: 1px;        margin: 5px 0 15px 0;        /*up right down left */        background: inherit;        background-color: #7a7e87;        border: none;        border-radius: 0px;        -moz-box-shadow: none;        -webkit-box-shadow: none;        box-shadow: none;        opacity: 0.5;      }        .container_vram_div {        height: 50px;      }        .text_fps_avg {        border-width: 0px;        position: relative;        display: inline-block;        font-family: 'ScoutCond Bold', 'ScoutCond Regular', 'ScoutCond';        font-weight: 700;        font-style: normal;        font-size: 128px;        line-height: 100px;        color: #36a9e1;        /* text-align: center */      }        /* SYSTEM RESOURCES */      /* u461_i */      #sysResTextHead {        /* border-width: 0px; */        position: relative;        display: block;        left: 0px;        top: 0px;        /* margin: 0px 0 15px 0; */        /*up right down left */        font-family: 'ScoutCond';        font-weight: 400;        font-style: normal;        font-size: 1.9vw;        color: #ffffff;        text-align: left;        line-height: 32px;        white-space: nowrap;      }        .sysResTextSmall {        /* border-width: 0px; */        position: relative;        float: right;        top: 0;        margin: 18px 0px 5px 0px;        /*up right down left */        font-family: 'ScoutRegular';        font-weight: 400;        font-style: normal;        font-size: 0.85vw;        color: #70747c;        text-align: right;        line-height: 5px;        /* line-height: 14px; */        white-space: nowrap;      }        .text_caption_monitor_quality {        /* u452*/        border-width: 0px;        position: relative;        display: inline-block;        /* height: 28px; */        font-family: 'ScoutRegular';        font-weight: 400;        font-style: normal;        font-size: 1.5vw;        color: rgb(255, 255, 255);        margin: 0 0 10px;        text-align: left;        line-height: 16px;      }        #sysOptHeader {        border-width: 0px;        position: relative;        left: 0px;        top: 10px;        width: 100%;        font-family: 'ScoutCond';        font-weight: 400;        font-style: normal;        font-size: 2vw;        color: rgb(255, 255, 255);        text-align: left;        /* line-height: 16px; */      }        #sysOptContent {        border-width: 0px;        position: relative;        top: 86px;        /*left: 2%;*/        /*width: 200%;*/        /* height: 30%; */        white-space: nowrap;      }        /* u463 - FPS BLOCK  */      #sysResMainBlock {        border-width: 0px;        position: relative;        width: 80%;        font-family: 'ScoutCond';        font-weight: 400;        font-style: normal;        font-size: 19px;        color: #ffffff;        text-align: left;        line-height: 18px;        min-height: 370px;        white-space: nowrap;      }        .sysResNumberPercentageDiff {        border-width: 0px;        position: relative;        display: inline-block;        /* width: 320px; */        font-family: 'ScoutCond';        font-weight: 400;        font-style: normal;        font-size: 22px;        color: #ffffff;        text-align: left;        line-height: 18px;        margin: 0 0 0 5px;        white-space: nowrap;      }        .sysResResourceCaption {        border-width: 0px;        /* position: relative; */        display: inline-block;        font-family: 'ScoutRegular';        margin: 10px 0 5px 1px;        /*up right down left */        font-size: 1vw;      }        .tooltipDiff {        position: relative;        display: inline-block;        cursor: pointer;      min-width: 50px;      }        /* Tooltip text */      .tooltipDiff .tooltiptextDiff {        visibility: hidden;        width: 150px;        background-color: grey;        color: #fff;        text-align: center;        font-family: 'ScoutRegular';        font-size: 14px;        font-weight: 200;        padding-bottom: 2px;        padding-top: 2px;        top: 100%;        left: 50%;        margin-left: -65px;        border-radius: 0px;              /* Position the tooltip text - see examples below! */        position: absolute;        z-index: 5;      }        .tooltipDiff .tooltipArrowUp {        width: 0;         height: 0;        border-left: 10px solid transparent;        border-right: 10px solid transparent;        border-bottom: 10px solid grey;        visibility: hidden;          /* top: -10px; */      }        .tooltipDiff:hover .tooltipArrowUp {        visibility: visible;      }        /* Show the tooltip text when you mouse over the tooltip container */      .tooltipDiff:hover .tooltiptextDiff {        visibility: visible;      }        .tooltipDiffFPS {        position: relative;        display: inline-block;        cursor: pointer;        min-width: 60px;        margin-left: 5px;        margin-top: 13px;      }        /* Tooltip text */      .tooltipDiffFPS .tooltiptextDiff {        visibility: hidden;        width: 150px;        background-color: grey;        color: #fff;        text-align: center;        font-family: 'ScoutRegular';        font-size: 14px;        font-weight: 200;        padding-bottom: 2px;        padding-top: 2px;        top: 100%;        left: 50%;        margin-left: -40px;        border-radius: 0px;              /* Position the tooltip text - see examples below! */        position: absolute;        z-index: 5;      }        .tooltipDiffFPS .tooltipArrowUp {        width: 0;         height: 0;        border-left: 10px solid transparent;        border-right: 10px solid transparent;        border-bottom: 10px solid grey;        visibility: hidden;          /* top: -10px; */      }        .tooltipDiffFPS:hover .tooltipArrowUp {        visibility: visible;      }        /* Show the tooltip text when you mouse over the tooltip container */      .tooltipDiffFPS:hover .tooltiptextDiff {        visibility: visible;      }        /* CHARTS - MAIN*/        .text_caption_fps_min_max {        /* u452*/        border-width: 0px;        position: relative;        display: inline-block;        font-family: 'ScoutCond';        font-weight: 400;        font-style: normal;        font-size: 33px;        color: #ffffff;        /* margin: 0 0 10px; */        text-align: center;        line-height: 16px;        height: 30px;      }        .text_fps_min_max { /*u449*/        border-width: 0px;        position: relative;        display: block;        font-family: 'ScoutCond';        font-weight: 400;        font-style: normal;        font-size: 30px;        color: #ffffff;        float: left;        text-align: left;        height: 30px;      }        #img_fps_avg_diff {        border-width: 0px;        position: relative;        display: inline-block;      }        .text_fps_diff { /*u504_i*/        border-width: 0px;        position: relative;        display: inline-block;        font-family: 'ScoutCond';        font-weight: 400;        font-style: normal;        font-size: 21px;        color: #ffffff;        text-align: center;        line-height: 16px;      }        /* /// Check box styles BEGIN /// */      /* The container */      #checkbox_custom_outer_container {        float: right;        position: relative;        background-color: #14181d;        border-style: solid;        border-width: 1px;        border: 1px solid rgba(54, 169, 225, 0.5);        /* border-color: #36a9e1; */        width: 330px;        height: 55px;        margin-top: 20px;        margin-right: 230px;        /* opacity: 0.5; */        /* margin-left: 590px; */      }        .checkbox_custom_container {        display: block;        position: relative;        padding-left: 20px;        margin-bottom: 10px;        margin-left: 7%;        margin-top: 14px;        cursor: pointer;        font-weight: 400;        font-style: normal;        font-family: 'ScoutCond';        font-size: 1.4vw;        color: #ffffff;        text-align: center;        line-height: 22px;        -webkit-user-select: none;        -moz-user-select: none;        -ms-user-select: none;        user-select: none;      }        /* Hide the browser's default checkbox */      .checkbox_custom_container input {        position: absolute;        opacity: 0%;        cursor: pointer;        height: 0;        width: 0;      }        /* Create a custom checkbox */      .checkbox_custom_checkmark {        position: absolute;        top: 0;        left: 0;        height: 25px;        width: 25px;        background-color: #ffffff;      }        /* On mouse-over, add a grey background color */      .checkbox_custom_container:hover input~.checkbox_custom_checkmark {        background-color: #c2c2c2;      }        /* When the checkbox is checked, add a white background */      .checkbox_custom_container input:checked~.checkbox_custom_checkmark {        background-color: #ffffff;      }        /* Create the checkmark/indicator (hidden when not checked) */      .checkbox_custom_checkmark:after {        content: "";        position: absolute;        display: none;      }        /* Show the checkmark when checked */      .checkbox_custom_container input:checked~.checkbox_custom_checkmark:after {        display: block;      }        /* Style the checkmark/indicator */      .checkbox_custom_container .checkbox_custom_checkmark:after {        left: 9px;        top: 5px;        width: 5px;        height: 10px;        border: solid #000000;        border-width: 0 3px 3px 0;        -webkit-transform: rotate(45deg);        -ms-transform: rotate(45deg);        transform: rotate(45deg);      }        /* /// Check box styles END/// */        /* /// System Info */      .textSystemInfoDiv {        position: relative;        font-family: 'ScoutRegular';        display: block;        width: 100%;        margin-top: 20px;      }        .textSystemInfoDiv div {        display: inline-block;        margin-bottom: 5px;      }        .textSystemInfoDiv div span {        border-width: 0px;        font-family: 'ScoutRegular';        font-weight: 400;        font-style: normal;        font-size: 0.9vw;        color: #ffffff;        line-height: 16px;      }        /* /// System Options */      .textSystemOptionsDiv {        position: relative;        display: block;        width: 100%;        top: 106px;        margin-top: 10px;        font-size: 0.9vw;        text-transform: uppercase;        line-height: 26px;      }            @media only screen and (max-width : 768px) {      .textSystemOptionsDiv {          font-size: 1.3vw;          }      }        .textSystemOptionsDiv div {        display: inline-block;        margin-bottom: 5px;      }        .textSystemOptionsDiv div span {        border-width: 0px;        font-family: 'ScoutRegular';        font-weight: 400;        font-style: normal;        color: #7a7e87;        line-height: 16px;      }        /* /// System Options */      .textSystemOptionsChangeDiv {        position: relative;        display: block;        width: 100%;        top: 106px;      }        .textSystemOptionsChangeDiv div {        display: inline-block;        margin-bottom: 5px;      }        .textSystemOptionsChangeDiv div span {        border-width: 0px;        font-family: 'Scout';        font-weight: 400;        font-style: normal;        font-size: 18px;        color: #797979;        line-height: 16px;      }    </style></head><body>	<img src="data:image/jpeg;base64,